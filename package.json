{
  "name": "super-kingdoms-pb",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "gen:types": "bash scripts/gen-types.sh",
    "dev:pb": "nodemon",
    "dev:pb:direct": "./pb/pocketbase serve --dev --dir=pb/pb_data --publicDir=pb/pb_public --hooksDir=pb/pb_hooks --migrationsDir=pb/pb_migrations --http=127.0.0.1:8090",
    "dev:pb:no-logs": "./pb/pocketbase serve --dir=pb/pb_data --publicDir=pb/pb_public --hooksDir=pb/pb_hooks --migrationsDir=pb/pb_migrations --http=127.0.0.1:8090",
    "dev:vite": "vite",
    "dev": "concurrently -n PB,VITE -c cyan,magenta \"npm run dev:pb\" \"npm run dev:vite\"",
    "dev:no-logs": "concurrently -n PB,VITE -c cyan,magenta \"npm run dev:pb:no-logs\" \"npm run dev:vite\"",
    "build:spa": "vite build",
    "build:pb": "bash scripts/build-pb.sh",
    "build": "npm run build:spa && npm run build:pb",
    "serve:prod": "./pb/pocketbase serve --dir=pb_prod_data --publicDir=pb/pb_public --hooksDir=pb/pb_hooks --migrationsDir=pb/pb_migrations --http=127.0.0.1:8091",
    "deploy:prod": "npm run build && npm run serve:prod",
    "test:pb": "./pb/pocketbase serve --dir=pb_test_data --hooksDir=pb/pb_hooks --migrationsDir=pb/pb_migrations --http=127.0.0.1:8092",
    "test": "bash scripts/test.sh",
    "test:watch": "vitest --config vitest.config.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@picocss/pico": "^2.1.1",
    "@tanstack/react-query": "^5.102.8",
    "lucide-react": "^1.39.0",
    "pocketbase": "^0.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.0",
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.14",
    "oxlint": "^1.79.0",
    "pocketbase-typegen": "^1.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.0"
  }
}
